# npm 11.4.1's dependency resolver crashes while walking vitest 4's optional peer set:
#   TypeError: Cannot read properties of null (reading 'edgesOut')
#       at #loadPeerSet (@npmcli/arborist/lib/arborist/build-ideal-tree.js)
#
# Skipping strict peer resolution avoids the crash. The alternative fixes are both worse:
# staying on vitest 2 leaves a critical advisory open, and installing @vitest/ui to satisfy
# the peer would pull in the very component that advisory is about.
#
# Set here rather than expecting people to remember a flag, so a plain `npm install` works.
# Revisit once npm ships a fix for the arborist bug.
legacy-peer-deps=true
