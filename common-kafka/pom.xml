<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.restaurant.ordering</groupId>
    <artifactId>restaurant-table-ordering</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>common-kafka</artifactId>
  <name>common-kafka</name>
  <description>Shared Kafka serialization defaults and the EventPublisher wrapper.</description>

  <dependencies>
    <dependency>
      <groupId>com.restaurant.ordering</groupId>
      <artifactId>common-events</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <!-- Spring Boot 4 split auto-configuration out of spring-boot-autoconfigure into
         per-technology modules. spring-kafka on its own gives you the library but no
         auto-configuration, so no KafkaTemplate and no listener container factory are
         ever created — and nothing warns you, the beans are simply absent. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-kafka</artifactId>
    </dependency>
    <!-- Explicit rather than transitive via spring-kafka: EventPublisher.publishAfterCommit
         depends directly on TransactionSynchronizationManager. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
