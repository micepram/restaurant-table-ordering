<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.restaurant.ordering</groupId>
    <artifactId>restaurant-table-ordering</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>gateway</artifactId>
  <name>gateway</name>
  <description>Single entry point: routes to the six services, handles CORS, and issues staff tokens.</description>

  <dependencies>
    <dependency>
      <groupId>com.restaurant.ordering</groupId>
      <artifactId>common-security</artifactId>
    </dependency>

    <!--
      Spring Cloud Gateway 5 renamed this artifact. The old spring-cloud-starter-gateway
      stopped publishing at 4.3.5 and will not resolve against the 2025.1.x BOM.

      NOTE: no spring-boot-starter-web here. The gateway is reactive (WebFlux); putting the
      servlet starter on the classpath makes it refuse to start.
    -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
